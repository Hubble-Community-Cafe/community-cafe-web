{
  "name": "community-cafe-web",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "description": "Self-maintained rebuild of hubble.cafe and meteor.cafe with a shared staff/board CMS.",
  "workspaces": [
    "shared-web",
    "public-hubble",
    "public-meteor",
    "admin"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:doctor": "bash scripts/dev-doctor.sh",
    "dev:seed": "bash scripts/dev-seed.sh",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26"
  }
}
