# Community Café Web, environment template.
# Copy to .env (gitignored) for local dev, or set these as runtime env in Portainer
# for the test/prod containers. NEVER commit real values.
# Variable names mirror the Harry List so the same patterns apply.

# ── Backend (Spring Boot) ──────────────────────────────────────────────────────
# Database (MariaDB). For docker compose these point at the db service.
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/cafeweb
SPRING_DATASOURCE_USERNAME=cafeweb
SPRING_DATASOURCE_PASSWORD=change-me

# Azure AD / Entra (new dedicated app registration for this project)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# RBAC bootstrap: Azure object id (OID) of the first admin, used only on first login
INITIAL_ADMIN_OID=

# Comma-separated allowed CORS origins (the public sites + admin). Empty = localhost only.
# e.g. https://test.hubble.cafe,https://test.meteor.cafe,https://admin.<host>
CORS_ALLOWED_ORIGINS=

# Mail (Microsoft Graph in prod, like the Harry List; Mailpit/SMTP used in dev/e2e).
# app.mail.enabled=false locally disables sending. From/staff addresses per bar are
# configured in application.properties.
APP_MAIL_ENABLED=false

# Sentry (backend project DSN). Leave empty to disable in dev.
SENTRY_DSN=

# ── Admin frontend (Vite, build-time VITE_* or runtime __RUNTIME_CONFIG__) ─────
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Defaults to window.location.origin if unset
VITE_REDIRECT_URI=
# Entra security group whose members may access the admin
VITE_ALLOWED_GROUP_ID=
# Backend API base URL
VITE_API_URL=http://localhost:8080
# Sentry (admin project DSN)
VITE_SENTRY_DSN=

# ── Public sites (Vite) ────────────────────────────────────────────────────────
# Backend API base URL (same backend serves both sites)
VITE_PUBLIC_API_URL=http://localhost:8080
# Self-hosted cookieless analytics (Plausible/Umami): the domain registered there
VITE_ANALYTICS_DOMAIN_HUBBLE=test.hubble.cafe
VITE_ANALYTICS_DOMAIN_METEOR=test.meteor.cafe
# Analytics script src (your self-hosted instance), e.g. https://analytics.<host>/script.js
VITE_ANALYTICS_SCRIPT_URL=
# Sentry (per public-site project DSN)
VITE_PUBLIC_HUBBLE_SENTRY_DSN=
VITE_PUBLIC_METEOR_SENTRY_DSN=
