# Community Café Web, environment template.
# Copy to .env (gitignored) for local dev, or set these as runtime env in Portainer
# for the test/prod containers. NEVER commit real values.
# Variable names mirror the Harry List so the same patterns apply.

# ── Backend (Spring Boot) ──────────────────────────────────────────────────────
# Database (MariaDB). For docker compose these point at the db service.
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/cafeweb
SPRING_DATASOURCE_USERNAME=cafeweb
SPRING_DATASOURCE_PASSWORD=change-me

# Azure AD / Entra (new dedicated app registration for this project)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# RBAC bootstrap: Azure object id (OID) of the first admin, used only on first login
INITIAL_ADMIN_OID=

# Comma-separated allowed CORS origins (the public sites + admin). Empty = localhost only.
# e.g. https://test.hubble.cafe,https://test.meteor.cafe,https://admin.<host>
CORS_ALLOWED_ORIGINS=

# Forms mail. provider: log (default, no send) | smtp (Mailpit/any SMTP) | graph (prod).
# graph reuses the Entra app creds above (AZURE_TENANT_ID/CLIENT_ID/CLIENT_SECRET) with
# its Mail.Send grant. e2e uses smtp -> Mailpit. Set APP_MAIL_PROVIDER=graph in prod.
APP_MAIL_PROVIDER=log
# From addresses per site (each must be a sendable mailbox in the tenant for graph).
APP_MAIL_FROM_HUBBLE=noreply@hubble.cafe
APP_MAIL_FROM_METEOR=noreply@meteor.cafe
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# Per-form recipient mailing lists.
APP_MAIL_FORMS_COMPLAINTS=nuisance@hubble.cafe
APP_MAIL_FORMS_SCREENS=screens@hubble.cafe
APP_MAIL_FORMS_DECLARATIONS=finance@hubble.cafe
APP_MAIL_FORMS_DECLARATIONS_CC=
APP_MAIL_FORMS_INFORMATION=info@hubble.cafe
APP_MAIL_FORMS_LOAN=loan@hubble.cafe

# ALTCHA bot protection on the public forms (self-hosted proof-of-work, no third party,
# no cookies). Disabled by default; enable in prod with a long random secret (keep it
# stable so challenges survive restarts and work across instances).
APP_ALTCHA_ENABLED=false
APP_ALTCHA_HMAC_KEY=
# Optional tuning: difficulty (higher = more client work) and challenge lifetime (seconds).
APP_ALTCHA_MAX_NUMBER=50000
APP_ALTCHA_EXPIRY_SECONDS=300

# Sentry (backend project DSN). Leave empty to disable in dev.
SENTRY_DSN=

# ── Admin frontend (Vite, build-time VITE_* or runtime __RUNTIME_CONFIG__) ─────
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Defaults to window.location.origin if unset
VITE_REDIRECT_URI=
# Entra security group whose members may access the admin
VITE_ALLOWED_GROUP_ID=
# Backend API base URL
VITE_API_URL=http://localhost:8080
# Sentry (admin project DSN)
VITE_SENTRY_DSN=

# ── Public sites (Vite) ────────────────────────────────────────────────────────
# Backend API base URL (same backend serves both sites)
VITE_PUBLIC_API_URL=http://localhost:8080
# Sentry (per public-site project DSN)
VITE_PUBLIC_HUBBLE_SENTRY_DSN=
VITE_PUBLIC_METEOR_SENTRY_DSN=
# Analytics: none for now (sites stay cookieless). Add a self-hosted script later if desired.
