{
  "name": "@cafe/shared-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared low-level building blocks for both public sites and the admin: API client, TypeScript types, theme tokens, self-hosted AXIS/Lato fonts, and base build/lint config. No page layouts.",
  "exports": {
    ".": "./src/index.ts",
    "./altcha": "./src/components/AltchaWidget.tsx",
    "./testing": "./src/testing/fixtures.ts",
    "./testing/forms": "./src/testing/forms.ts",
    "./theme.css": "./src/theme/theme.css",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint.config.base.js": "./eslint.config.base.js"
  },
  "files": [
    "src",
    "fonts",
    "tsconfig.base.json",
    "eslint.config.base.js"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^11.12.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.1"
  },
  "peerDependencies": {
    "altcha": "^3.6.0",
    "react": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "altcha": "^3.6.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  }
}
