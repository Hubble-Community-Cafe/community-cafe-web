{
  "name": "@cafe/shared-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared low-level building blocks for both public sites and the admin: API client, TypeScript types, theme tokens, self-hosted AXIS/Lato fonts, and base build/lint config. No page layouts.",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme/theme.css",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint.config.base.js": "./eslint.config.base.js"
  },
  "files": [
    "src",
    "fonts",
    "tsconfig.base.json",
    "eslint.config.base.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^10.70.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
